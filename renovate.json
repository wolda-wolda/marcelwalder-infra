{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "timezone": "Europe/Vienna",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "ignoreDeps": [
    "hashicorp/terraform"
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)(?:docker-)?compose[^/]*\\.ya?ml$/",
      "/^ansible/files/.+-compose\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Prefer OpenTofu Registry for providers and modules",
      "matchDatasources": [
        "terraform-provider",
        "terraform-module"
      ],
      "registryUrls": [
        "https://registry.opentofu.org"
      ]
    },
    {
      "description": "Group GitHub Actions updates (excluding OpenTofu CLI)",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "!opentofu"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group OpenTofu CLI and provider updates",
      "matchManagers": [
        "terraform"
      ],
      "groupName": "OpenTofu"
    },
    {
      "description": "Group OpenTofu CLI version from setup-opentofu",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "opentofu"
      ],
      "groupName": "OpenTofu"
    },
    {
      "description": "Group Docker Compose container updates",
      "matchManagers": [
        "docker-compose"
      ],
      "groupName": "Docker Compose images"
    }
  ]
}
