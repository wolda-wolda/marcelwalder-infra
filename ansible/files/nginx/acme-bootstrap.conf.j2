server {
    listen 80;
    listen [::]:80;
    server_name {{ item.server_names }};

    location /.well-known/acme-challenge/ {
        root {{ item.webroot }};
        try_files $uri =404;
    }

    location / {
        return 200 "{{ item.domain }} ACME bootstrap\n";
        add_header Content-Type text/plain;
    }
}
