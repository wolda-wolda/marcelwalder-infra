OVERRIDE_HOSTNAME=mail.marcelwalder.eu
SSL_TYPE=manual
SSL_CERT_PATH=/etc/letsencrypt/live/mail.marcelwalder.eu-0001/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/mail.marcelwalder.eu-0001/privkey.pem

# Outbound Relay
DEFAULT_RELAY_HOST=[smtp.email.eu-frankfurt-1.oci.oraclecloud.com]:587
RELAY_HOST=smtp.email.eu-frankfurt-1.oci.oraclecloud.com
RELAY_PORT=587

ENABLE_RSPAMD=1
ENABLE_CLAMAV=0
ENABLE_FAIL2BAN=1
ENABLE_POSTGREY=0
ENABLE_POP3=0
ENABLE_MANAGESIEVE=1
ONE_DIR=1
POSTMASTER_ADDRESS=postmaster@marcelwalder.eu
LOG_LEVEL=info
ENABLE_MTA_STS=1
